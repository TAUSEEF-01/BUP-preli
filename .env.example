# Copy to .env and fill in values. Never commit .env.

# Primary LLM (required for POST /optimize-energy)
# LLM_PROVIDER: anthropic | openai_compat
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
# openai_compat only, e.g. https://api.openai.com/v1 (default), https://api.groq.com/openai/v1,
# https://generativelanguage.googleapis.com/v1beta/openai, https://openrouter.ai/api/v1
LLM_BASE_URL=
# Optional: anthropic effort level (e.g. low); temperature (number or "none")
LLM_EFFORT=
LLM_TEMPERATURE=

# Optional backup LLM (independent provider/credentials), same meaning as above
LLM_BACKUP_PROVIDER=
LLM_BACKUP_MODEL=
LLM_BACKUP_API_KEY=
LLM_BACKUP_BASE_URL=
LLM_BACKUP_EFFORT=
LLM_BACKUP_TEMPERATURE=

# Service behaviour
REQUEST_DEADLINE_SECONDS=25
LLM_TIMEOUT_SECONDS=10
LLM_CACHE_SIZE=512
LLM_MAX_CONCURRENCY=8
LLM_WARMUP=true
LOG_LEVEL=INFO
PORT=8000
